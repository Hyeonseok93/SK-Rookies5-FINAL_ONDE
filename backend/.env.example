# Local backend / docker-compose secrets
# Copy to `.env` and fill in values. Do not commit `.env`.

# MariaDB
MARIADB_DATABASE=onde
MARIADB_USER=onde
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# App DB connection (docker network hosts are set in docker-compose.yml)
DB_URL=jdbc:mariadb://mariadb:3306/onde
DB_USERNAME=onde
DB_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth / crypto
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AES_SECRET_KEY=change-me-32-byte-hex-or-string

# Mail (local dummy)
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=change-me

# PortOne (local dummy)
PORTONE_IMP_KEY=change-me
PORTONE_IMP_SECRET=change-me

# MinIO / S3 (local)
MINIO_ROOT_USER=onde-s3-user
MINIO_ROOT_PASSWORD=change-me
AWS_S3_BUCKET=onde-local
AWS_CLOUDFRONT_DOMAIN=http://localhost:9000/onde-local
AWS_S3_ENDPOINT=http://minio:9000
AWS_REGION=ap-northeast-2

# External APIs (local dummy)
NTS_SERVICE_KEY=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me

# Admin healthcheck (local only — do not use 0.0.0.0/0 in production)
HEALTH_CHECK_ALLOWED_IP=0.0.0.0/0
