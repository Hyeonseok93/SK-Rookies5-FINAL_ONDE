# GitHub Actions — Repository secrets checklist (Frontend)
# Settings → Secrets and variables → Actions 에 아래 이름으로 등록하세요.
# 이 파일은 이름 샘플이며, 실제 값은 커밋하지 마세요.
#
# 로컬 개발: ../.env.example → .env
# 빌드 타임 VITE_* 는 이미지 빌드 인자에 들어갑니다.

# --- AWS / 배포 ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
INFRA_REPO_TOKEN=ghp_...

# --- Frontend build-time ---
VITE_S3_ENDPOINT=https://xxxx.cloudfront.net
# (로컬 .env.example 참고 — CI에서 쓸 경우 추가)
# VITE_USER_API_BASE=https://onde.click
# VITE_ADMIN_API_BASE=https://rookies.onde.click
# VITE_PORTONE_IMP_CODE=
# VITE_PORTONE_PG=
