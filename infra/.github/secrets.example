# GitHub Actions — Repository secrets checklist (Infra / Deploy)
# Settings → Secrets and variables → Actions 에 아래 이름으로 등록하세요.
# 이 파일은 이름 샘플이며, 실제 값은 커밋하지 마세요.
#
# UR-VULN/Onde_Infra 의 deploy.yml · terraform-cicd.yml 기준입니다.

# --- AWS ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
DEPLOY_BUCKET=your-deploy-bucket

# --- EC2 targets ---
WEB_EC2_INSTANCE_ID=i-xxxxxxxx
WAS_EC2_INSTANCE_ID_1=i-xxxxxxxx
ADMIN_EC2_INSTANCE_ID=i-xxxxxxxx

# --- Terraform / runtime shared ---
DB_HOST=xxxx.ap-northeast-2.rds.amazonaws.com
DB_URL=jdbc:mariadb://xxxx.ap-northeast-2.rds.amazonaws.com:3306/onde
DB_USERNAME=onde
DB_PASSWORD=change-me

REDIS_HOST=your-redis-endpoint
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string
AES_SECRET_KEY=change-me-32-chars-or-hex

AWS_S3_BUCKET=your-onde-bucket
AWS_CLOUDFRONT_DOMAIN=https://xxxx.cloudfront.net

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
NTS_SERVICE_KEY=change-me
